# Set these in your hosting provider's private secret/environment settings.
TWELVEDATA_API_KEY=replace_with_your_private_key
OTCHARTS_API_KEY=replace_with_your_private_otcharts_token
# Comma-separated exact website origins; do not use * in production.
ALLOWED_ORIGINS=https://codex-inn.github.io
# Candle responses are cached to reduce provider requests.
CANDLES_CACHE_SECONDS=60
